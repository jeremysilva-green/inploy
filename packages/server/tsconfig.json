{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "lib": ["ES2022"],
    "paths": {
      "@inploy/shared": ["../shared/src/index.ts"],
      "@inploy/shared/*": ["../shared/src/*"]
    },
    "baseUrl": "."
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "prisma"],
  "references": [
    { "path": "../shared" }
  ]
}
