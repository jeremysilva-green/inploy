{
  "name": "inploy",
  "version": "1.0.0",
  "description": "Professional employer check-in/check-out web application",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm run --parallel dev",
    "dev:server": "pnpm --filter server dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm run --recursive build",
    "build:server": "pnpm --filter server build",
    "build:web": "pnpm --filter web build",
    "test": "pnpm run --recursive test",
    "lint": "pnpm run --recursive lint",
    "clean": "pnpm run --recursive clean && rm -rf node_modules",
    "migrate:dev": "pnpm --filter server migrate:dev",
    "migrate:deploy": "pnpm --filter server migrate:deploy",
    "db:seed": "pnpm --filter server db:seed",
    "db:studio": "pnpm --filter server db:studio"
  },
  "keywords": [
    "check-in",
    "time-tracking",
    "employer",
    "attendance",
    "payroll"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
